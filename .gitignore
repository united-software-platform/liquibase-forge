# Секреты проекта: не попадают в коммиты
.env

# След операций formular: локальный, не коммитится
backlog/*

# Конфигурация IDE: локальная, не коммитится
.idea/

# Регистрация харнесов: навыки и команды OpenSpec разворачивает openspec init, содержимое
# каталогов разработчик создаёт сам под свои инструменты
.claude/
.zcode/

# Файлы forge вне принятого состояния: драйвер Liquibase — локальные, не коммитятся
.forge/

# Принятое состояние forge в репозитории разработки: проверочные прогоны не коммитятся.
# Корень задаёт FORGE_ACCEPTED_DIR (здесь .forge/db); /db/ — страховка от незаданной переменной.
# В целевом проекте db/ коммитится
/db/

# Окружение uv и кеш байткода Python: локальные, не коммитятся
.venv/
__pycache__/
