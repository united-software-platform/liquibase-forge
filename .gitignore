# Секреты проекта: не попадают в коммиты [BOOT-006]
.env
.ssh/
.claude-accounts/

# След операций formular: локальный, не коммитится
backlog/*

# Конфигурация IDE: локальная, не коммитится
.idea/

# >>> liquibase-forge
# Liquibase Forge: файлы обмена со шлюзом и окружение uv подпроекта CLI — локальные
.forge/
tools/forge/.venv/
# Данные целевой БД lbfr-db: каталог создаёт make forge-env-up, остальной data/ — файлы проекта
/data/lbfr-db/
# <<< liquibase-forge

# Принятое состояние forge в репозитории разработки: проверочные прогоны не коммитятся.
# Корень задаёт FORGE_ACCEPTED_DIR (здесь .forge/db); /db/ — страховка от незаданной переменной.
# Файл в поставку forge не входит: в целевом проекте db/ коммитится
/db/

# Окружение uv и кеш байткода Python: локальные, не коммитятся
.venv/
__pycache__/
