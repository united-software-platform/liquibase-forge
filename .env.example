# Секреты Liquibase Forge: в шаблоне только имена, значения заполняются локально. Сам .env
# в git не попадает. Несекретные координаты forge объявлены в mise.toml (ENV-005).

# Целевая БД операций forge — база FORGE_DB_NAME на сервере PostgreSQL. Роль с этим именем
# и паролем forge env up создаёт, если её нет
FORGE_DB_USER=forge
FORGE_DB_PASSWORD=

# Администратор сервера PostgreSQL: от его имени forge env up создаёт роль и базу. Пусто —
# учётные данные целевой БД; пока роли целевой БД нет, администратор обязателен
FORGE_DB_ADMIN_USER=
FORGE_DB_ADMIN_PASSWORD=

# Сервер интеграционных тестов forge: роль должна уметь создавать базы — каждый тест создаёт
# базу t_<идентификатор> и удаляет её после себя
FORGE_TEST_DB_USER=
FORGE_TEST_DB_PASSWORD=
