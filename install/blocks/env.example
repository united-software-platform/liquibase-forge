# Liquibase Forge: целевая БД операций (сервис lbfr-db)
FORGE_DB_HOST=lbfr-db
FORGE_DB_PORT=5432
# Порт lbfr-db на хосте для подключения клиентом (psql, IDE), из диапазона проекта 11900–11999;
# FORGE_DB_PORT выше — порт внутри сети Compose, по нему ходят агент и шлюз
FORGE_DB_HOST_PORT=11932
FORGE_DB_NAME=forge
FORGE_DB_USER=forge
FORGE_DB_PASSWORD=forge

# Liquibase Forge: сервер БД интеграционных тестов (сервис lbfr-db-test); каждый тест создаёт свою БД
FORGE_TEST_DB_HOST=lbfr-db-test
FORGE_TEST_DB_PORT=5432
FORGE_TEST_DB_NAME=forge_test
FORGE_TEST_DB_USER=forge_test
FORGE_TEST_DB_PASSWORD=forge_test
# БД, на которые шлюз Liquibase разрешает накат: записи хост:порт/имя через запятую,
# * на месте имени — любая БД сервера. Пусто — шлюз отклоняет любой запрос
FORGE_TEST_DB_ALLOWLIST=lbfr-db:5432/forge,lbfr-db-test:5432/*

# Liquibase Forge: корень принятого состояния — относительный путь внутри проекта, куда
# forge close принимает модель и changelog. В целевом проекте db (коммитится); в репозитории
# разработки Liquibase Forge — .forge/db, чтобы проверочные прогоны не попадали в git
FORGE_ACCEPTED_DIR=db

# Liquibase Forge: образы. После правки перезапустить раннер и сессию агента
LBFR_POSTGRES_IMAGE=postgres:17.11
# Liquibase 5.x собирается с драйвером PostgreSQL (docker/liquibase/Dockerfile);
# имя собранного образа включает обе версии, чтобы их смена вела к пересборке
LBFR_LIQUIBASE_BASE_IMAGE=liquibase/liquibase:5.0.4
LBFR_LIQUIBASE_POSTGRESQL_DRIVER=42.7.13
LBFR_LIQUIBASE_IMAGE=lbfr-liquibase:5.0.4-pg42.7.13
